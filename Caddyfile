:8080 {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	}

	# Every current demo has a static frontend. The two optional live-data APIs
	# use the /api/* blocks below; all analysis and visualization stays in the
	# browser. The launcher also retains generic Streamlit support for a future
	# process-backed demo, but no current route uses it.
	#
	# `forward_auth` is not doing authentication here; it is the hook that makes
	# an optional API start on demand. Caddy asks launcher.py about the request
	# first, and launcher.py only answers 200 once that process is listening.
	#
	# Static/JS frontends use handle_path + root+file_server out of
	# apps/<slug> (or static/demos/<slug> for one that isn't its own submodule),
	# since those don't care about the prefix and need no process at all.
	# X-Original-Uri is set explicitly rather than relying on forward_auth's
	# defaults. The generic Streamlit launcher path needs the real path to tell a
	# page load from a reconnect so retries cannot restart a deliberately stopped
	# process.
	#
	# momentum-factor is a hybrid: a static frontend (no process, file_server
	# below) plus a tiny on-demand JSON API behind /api/* for its live-refresh
	# toggle only. The api block must come first: handle_path routes are matched
	# in file order, and the more specific /api/* prefix has to win before the
	# catch-all /demos/momentum-factor/* block below claims the request.
	handle_path /demos/momentum-factor/api/* {
		forward_auth 127.0.0.1:9000 {
			uri /activate/momentum-factor
			header_up X-Original-Uri {http.request.uri}
		}
		reverse_proxy 127.0.0.1:8501
	}

	handle_path /demos/momentum-factor/* {
		root * /app/apps/momentum-factor/frontend
		file_server
	}

	# factor-regression is the same hybrid as momentum-factor: static frontend
	# plus a tiny on-demand API behind /api/* for live French data refresh and
	# Yahoo Finance ticker lookups. See the comment on momentum-factor above.
	handle_path /demos/factor-regression/api/* {
		forward_auth 127.0.0.1:9000 {
			uri /activate/factor-regression
			header_up X-Original-Uri {http.request.uri}
		}
		reverse_proxy 127.0.0.1:8502
	}

	handle_path /demos/factor-regression/* {
		root * /app/apps/factor-regression/frontend
		file_server
	}

	# nn-foundations is a fully static demo (no process, like security-anti-patterns
	# below): a from-scratch neural-network library in plain JavaScript, with
	# TensorFlow.js lazy-loaded only by its one comparison tab.
	handle_path /demos/nn-foundations* {
		root * /app/apps/nn-foundations/frontend
		file_server
	}

	handle_path /demos/security-anti-patterns* {
		root * /app/apps/security-anti-patterns
		file_server
	}

	handle {
		root * /app/static
		file_server
	}
}
